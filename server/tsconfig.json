{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["index.ts", "state-simulator.ts", "../src/game/**/*.ts", "../src/platform/**/*.tsx", "../src/vite-env.d.ts"],
  "exclude": ["../src/game/modules"]
}
